{
  "name": "jacquard-loom-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive simulator of the Jacquard loom: punch the cards, turn the loom, and watch the head choose every thread. Mechanism in 2D and 3D, lessons and games.",
  "license": "Apache-2.0",
  "homepage": "https://wixette.github.io/jacquard-loom-simulator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wixette/jacquard-loom-simulator.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:refs": "node tools/check-refs.mjs",
    "test": "node --test \"tests/**/*.test.js\" \"tools/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "stamp": "node tools/stamp.mjs",
    "version": "node tools/stamp.mjs",
    "serve": "node tools/serve.mjs 8000",
    "shots": "node tools/shots.mjs",
    "video": "node tools/video.mjs",
    "selftest": "node tools/selftest.mjs",
    "vendor": "node tools/vendor.mjs",
    "build:model": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --factory-startup --python-exit-code 1 --python blender/scripts/build_units.py"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@material-symbols/svg-400": "0.48.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "esbuild": "0.25.0",
    "three": "0.186.1",
    "typescript": "7.0.2"
  }
}
